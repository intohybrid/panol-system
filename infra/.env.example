# Sistema de Pañol — variables de entorno para infraestructura local
# Copiar a `.env` (mismo directorio) y ajustar si fuera necesario.
# Estas credenciales son SOLO para desarrollo local. No usar en producción.

# ──────────────────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────────────────
POSTGRES_USER=panol
POSTGRES_PASSWORD=panol
POSTGRES_PORT=5432

# ──────────────────────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────────────────────
MONGO_USER=panol
MONGO_PASSWORD=panol
MONGO_PORT=27017

# ──────────────────────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────────────────────
RABBITMQ_USER=panol
RABBITMQ_PASSWORD=panol
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ──────────────────────────────────────────────────────────
# Adminer (UI Postgres) y Mongo Express
# ──────────────────────────────────────────────────────────
ADMINER_PORT=8080
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=panol
MONGO_EXPRESS_PASSWORD=panol

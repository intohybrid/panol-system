"380" height="70" as="geometry"/></mxCell><mxCell id="sec_demo_svc" value="Microservicios (6) - NestJS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_demo"><mxGeometry x="20" y="330" width="1100" height="280" as="geometry"/></mxCell><mxCell id="svc_demo_auth-svc" value="auth-svc :3001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_demo"><mxGeometry x="60" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_demo_inv-svc" value="inventory-svc :3002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_demo"><mxGeometry x="320" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_demo_req-svc" value="request-svc :3003" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_demo"><mxGeometry x="580" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_demo_loan-svc" value="loan-svc :3004" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_demo"><mxGeometry x="840" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_demo_ai-asst" value="ai-assistant-svc :3005&#10;(keyword matching mock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_demo"><mxGeometry x="60" y="460" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_demo_ai-asst-detail" value="ALCANCE&#10;5 servicios + gateway = 6&#10;No notification-svc&#10;No ai-risk-svc&#10;No reports-svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="col_demo"><mxGeometry x="580" y="460" width="220" height="80" as="geometry"/></mxCell><mxCell id="sec_prod_svc" value="Microservicios (9) - NestJS hexagonal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_prod"><mxGeometry x="20" y="330" width="1100" height="280" as="geometry"/></mxCell><mxCell id="svc_prod_auth-svc" value="auth-svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_prod"><mxGeometry x="60" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_prod_inv-svc" value="inventory-svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_prod"><mxGeometry x="320" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_prod_req-svc" value="request-svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_prod"><mxGeometry x="580" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_prod_loan-svc" value="loan-svc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_prod"><mxGeometry x="840" y="370" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_prod_notif" value="notification-svc&#10;+ tickets PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="60" y="460" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_prod_risk" value="ai-risk-svc&#10;(scoring ONNX)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="320" y="460" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_prod_ai-asst" value="ai-assistant-svc&#10;(MCP + OpenAI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" vertex="1" parent="col_prod"><mxGeometry x="580" y="460" width="220" height="80" as="geometry"/></mxCell><mxCell id="svc_prod_reports" value="reports-svc&#10;(CQRS read-model)&#10;ADR-015" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="840" y="460" width="220" height="80" as="geometry"/></mxCell><mxCell id="sec_demo_db" value="Persistencia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_demo"><mxGeometry x="20" y="630" width="1100" height="220" as="geometry"/></mxCell><mxCell id="db_demo_main" value="&lt;b&gt;In-memory por servicio&lt;/b&gt;&lt;br/&gt;Map&amp;lt;id, User&amp;gt; en auth-svc&lt;br/&gt;Map&amp;lt;id, Resource&amp;gt; en inventory&lt;br/&gt;Map&amp;lt;id, Request&amp;gt; en request&lt;br/&gt;Map&amp;lt;id, Loan&amp;gt; en loan&lt;br/&gt;&lt;br/&gt;Sin persistencia entre reinicios&lt;br/&gt;(seed hardcoded al boot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_demo"><mxGeometry x="60" y="670" width="380" height="160" as="geometry"/></mxCell><mxCell id="db_demo_diff" value="&lt;b&gt;Diferencia clave&lt;/b&gt;&lt;br/&gt;Sin Prisma. Sin migraciones.&lt;br/&gt;Sin SQL. Sin transacciones.&lt;br/&gt;Sin lock optimista (RC.12).&lt;br/&gt;&lt;br/&gt;Suficiente para demo;&lt;br/&gt;no apto para produccion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="col_demo"><mxGeometry x="480" y="670" width="280" height="160" as="geometry"/></mxCell><mxCell id="db_demo_shared" value="&lt;b&gt;Tipos compartidos&lt;/b&gt;&lt;br/&gt;app/shared/src/models/&lt;br/&gt;User, Resource, Request, Loan&lt;br/&gt;(interfaces TS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_demo"><mxGeometry x="800" y="670" width="280" height="160" as="geometry"/></mxCell><mxCell id="sec_prod_db" value="Persistencia (database-per-service)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_prod"><mxGeometry x="20" y="630" width="1100" height="220" as="geometry"/></mxCell><mxCell id="db_prod_auth_db" value="auth_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="60" y="670" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_inventory_db" value="inventory_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="220" y="670" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_request_db" value="request_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="380" y="670" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_loan_db" value="loan_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="540" y="670" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_notification_db" value="notification_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="700" y="670" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_ai_risk_db" value="ai_risk_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="860" y="670" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_ai_assistant_db" value="ai_assistant_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="60" y="740" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_reports_db" value="reports_db&#10;(Postgres 16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="220" y="740" width="140" height="50" as="geometry"/></mxCell><mxCell id="db_prod_orm" value="&lt;b&gt;ORM:&lt;/b&gt; Prisma 5&lt;br/&gt;&lt;b&gt;Lock optimista:&lt;/b&gt; resources.version (RC.12)&lt;br/&gt;&lt;b&gt;Migraciones:&lt;/b&gt; expand/contract&lt;br/&gt;&lt;b&gt;Outbox:&lt;/b&gt; outbox_events + processed_events&lt;br/&gt;Ver ERD-01-modelo-datos.drawio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="380" y="740" width="700" height="80" as="geometry"/></mxCell><mxCell id="sec_demo_bus" value="Comunicacion entre servicios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_demo"><mxGeometry x="20" y="870" width="1100" height="280" as="geometry"/></mxCell><mxCell id="bus_demo_http" value="&lt;b&gt;HTTP sincrono directo&lt;/b&gt;&lt;br/&gt;No hay broker.&lt;br/&gt;service-a llama a service-b via HTTP.&lt;br/&gt;Si una llamada falla, falla la cadena." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_demo"><mxGeometry x="60" y="910" width="320" height="130" as="geometry"/></mxCell><mxCell id="bus_demo_flow" value="&lt;b&gt;Ejemplo: crear solicitud&lt;/b&gt;&lt;br/&gt;Portal -&amp;gt; gateway -&amp;gt; request-svc&lt;br/&gt;request-svc -&amp;gt; HTTP -&amp;gt; inventory-svc (reserva)&lt;br/&gt;inventory-svc -&amp;gt; 200 OK&lt;br/&gt;request-svc -&amp;gt; 201 Created&lt;br/&gt;&lt;br/&gt;&lt;b&gt;EIP simulados (no reales):&lt;/b&gt;&lt;br/&gt;Pub-Sub = HTTP fan-out&lt;br/&gt;Request-Reply = HTTP normal&lt;br/&gt;Outbox = no implementado&lt;br/&gt;DLX = no implementado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="col_demo"><mxGeometry x="400" y="910" width="360" height="220" as="geometry"/></mxCell><mxCell id="bus_demo_note" value="&lt;b&gt;Por que es valido en demo:&lt;/b&gt;&lt;br/&gt;Permite mostrar el flujo end-to-end&lt;br/&gt;sin levantar RabbitMQ.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Por que NO en prod:&lt;/b&gt;&lt;br/&gt;Acopla services. Si auth-svc cae,&lt;br/&gt;todo cae. No hay buffering ni retries.&lt;br/&gt;Cualquier microservicios real necesita&lt;br/&gt;un broker." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8d0;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacingLeft=4;spacingTop=2;" vertex="1" parent="col_demo"><mxGeometry x="780" y="910" width="300" height="220" as="geometry"/></mxCell><mxCell id="sec_prod_bus" value="Comunicacion entre servicios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_prod"><mxGeometry x="20" y="870" width="1100" height="280" as="geometry"/></mxCell><mxCell id="bus_prod_rmq" value="&lt;b&gt;RabbitMQ 3.12 + plugins&lt;/b&gt;&lt;br/&gt;(delayed_message, prometheus)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4 exchanges:&lt;/b&gt;&lt;br/&gt;domain.events (topic) - Pub-Sub&lt;br/&gt;domain.commands (direct) - Req-Reply&lt;br/&gt;domain.delayed (x-delayed) - TTL&lt;br/&gt;domain.dlx (fanout) - DLC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="60" y="910" width="320" height="200" as="geometry"/></mxCell><mxCell id="bus_prod_eip" value="&lt;b&gt;EIPs implementados (Hohpe):&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&amp;#9679; Publish-Subscribe (EIP-02)&lt;br/&gt;&amp;#9679; Content-Based Router (EIP-02)&lt;br/&gt;&amp;#9679; Message Expiration (EIP-03)&lt;br/&gt;&amp;#9679; Dead Letter Channel&lt;br/&gt;&amp;#9679; Request-Reply + Correlation Id (EIP-04)&lt;br/&gt;&amp;#9679; Transactional Outbox (EIP-05)&lt;br/&gt;&amp;#9679; Idempotent Receiver (EIP-05)&lt;br/&gt;&lt;br/&gt;Ver: 04-eip-catalog.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="400" y="910" width="360" height="220" as="geometry"/></mxCell><mxCell id="bus_prod_saga" value="&lt;b&gt;Saga coreografiada&lt;/b&gt;&lt;br/&gt;(no orquestada — ADR-006)&lt;br/&gt;&lt;br/&gt;request.created -&amp;gt; reserva&lt;br/&gt;loan.issued -&amp;gt; descuento&lt;br/&gt;loan.closed -&amp;gt; reposicion&lt;br/&gt;request.expired -&amp;gt; compensacion&lt;br/&gt;&lt;br/&gt;Ver: 05-saga-coreografiada.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="780" y="910" width="300" height="220" as="geometry"/></mxCell><mxCell id="sec_demo_obs" value="Observabilidad / Operacion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_demo"><mxGeometry x="20" y="1170" width="1100" height="130" as="geometry"/></mxCell><mxCell id="obs_demo" value="&lt;b&gt;concurrently&lt;/b&gt; para arrancar 8 procesos&lt;br/&gt;Console logs por color (-c blue,green,...)&lt;br/&gt;Sin tracing distribuido&lt;br/&gt;Sin metrics&lt;br/&gt;Sin Docker (procesos npm puros)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_demo"><mxGeometry x="60" y="1200" width="1020" height="90" as="geometry"/></mxCell><mxCell id="sec_prod_obs" value="Observabilidad / Operacion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#666666;spacingLeft=8;spacingTop=4;" vertex="1" parent="col_prod"><mxGeometry x="20" y="1170" width="1100" height="130" as="geometry"/></mxCell><mxCell id="obs_prod" value="&lt;b&gt;OpenTelemetry SDK&lt;/b&gt; + Pino logs estructurados&lt;br/&gt;&lt;b&gt;Tempo&lt;/b&gt; (traces) + &lt;b&gt;Loki&lt;/b&gt; (logs) + &lt;b&gt;Grafana&lt;/b&gt; dashboards&lt;br/&gt;&lt;b&gt;Docker compose&lt;/b&gt; para dev local (validado: 7/7 smoke tests OK)&lt;br/&gt;Cloud-agnostico (ADR-009): EKS/AKS/GKE/on-premise&lt;br/&gt;Ver: 01-stack-tecnologico.md, US-049 (deferred a Sprint 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="col_prod"><mxGeometry x="60" y="1200" width="1020" height="90" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Convenciones:&lt;/b&gt;&lt;br/&gt;&amp;#128997; &lt;b&gt;Verde&lt;/b&gt; = componente/concepto compartido entre demo y produccion&lt;br/&gt;&amp;#128993; &lt;b&gt;Amarillo&lt;/b&gt; = solo en demo (mock o shortcut)&lt;br/&gt;&amp;#128992; &lt;b&gt;Naranja&lt;/b&gt; = solo en produccion (no implementado en demo)&lt;br/&gt;&amp;#128308; &lt;b&gt;Rojo&lt;/b&gt; = diferencia clave que requiere atencion en mesa redonda&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Decision documentada en:&lt;/b&gt; app/ARQUITECTURA-DEMO.md&lt;br/&gt;&lt;b&gt;Trazabilidad ADRs:&lt;/b&gt; ADR-002 (Postgres), ADR-005 (RabbitMQ), ADR-006 (saga coreo), ADR-008 (gateway), ADR-016 (UI routing)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8d0;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacingLeft=4;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="2320" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>

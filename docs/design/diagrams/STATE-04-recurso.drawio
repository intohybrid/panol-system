<mxfile host="app.diagrams.net" agent="hand-crafted" type="device">
  <diagram id="state-04-recurso" name="STATE-04 Recurso">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="STATE-04 — Máquina de estado: Recurso (ítem del inventario)&#10;Servicio dueño: inventory-svc   |   Referencia: docs/architecture/08-estados-entidades.md §4   |   RC.03, RC.18, RF-C.08" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="120" y="310" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s_activo" value="ACTIVO&#10;(disponible si hay stock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="290" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s_mant" value="EN_MANTENCION&#10;(oculto para solicitudes,&#10;reversible, RF-C.08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s_baja" value="BAJA&#10;(terminal, registro conservado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;strokeWidth=3" vertex="1" parent="1">
          <mxGeometry x="680" y="440" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_start" value="alta (Pañolero o Jefe) /&#10;resource.created + stock.changed&#10;motivo=ALTA" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1" source="start" target="s_activo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_act_mant" value="marca En Mantención /&#10;resource.maintenance.started" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1" source="s_activo" target="s_mant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_mant_act" value="reactiva /&#10;resource.maintenance.ended" style="endArrow=classic;html=1;fontSize=10;curved=1" edge="1" parent="1" source="s_mant" target="s_activo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="260" />
              <mxPoint x="500" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_act_baja" value="baja [motivo obligatorio] /&#10;resource.deactivated + stock.changed&#10;motivo=BAJA" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1" source="s_activo" target="s_baja">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_mant_baja" value="baja [motivo obligatorio] /&#10;resource.deactivated" style="endArrow=classic;html=1;fontSize=10" edge="1" parent="1" source="s_mant" target="s_baja">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note_stock" value="Niveles de stock (NORMAL/BAJO/CRITICO) NO son estados del recurso.&#10;Son indicadores derivados de (stockActual, stockMaximoHistorico).&#10;Eventos relacionados: stock.low (cruce descendente) y stock.normalized (cruce ascendente).&#10;El recurso sigue en estado ACTIVO mientras cambian sus niveles." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="140" y="580" width="820" height="110" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="Verde: operativo   |   Amarillo: suspendido reversible   |   Morado doble borde: terminal" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1320" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>

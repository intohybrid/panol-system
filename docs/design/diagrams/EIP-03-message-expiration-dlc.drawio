        <mxCell id="note1" value="Message Expiration:&#10;El broker (no la app) gestiona el tiempo. Si el consumer&#10;no valida en 15 min, el mensaje se considera &apos;muerto&apos; y&#10;pasa al DLX automáticamente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
